{
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      { "source": "**", "destination": "/index.html" }
    ]
    
  },
   "scripts": {
    "build:assets": "cpx \"src/**/*\" dist/src",
    "build": "your-tailwind-build-command && npm run build:assets"
  }
}
